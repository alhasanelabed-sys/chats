  "segments": [
    {
      "id": "s01",
      "start": 0.0,
      "end": 8.0,
      "speaker_id": "synth_01",
      "text": "نبدأ فحص اختلاف الضجيج الرقمي على النص نفسه."
    },
    {
      "id": "s02",
      "start": 10.0,
      "end": 18.0,
      "speaker_id": "synth_02",
      "text": "سأراجع حفظ التسجيل غدًا."
    },
    {
      "id": "s03",
      "start": 20.0,
      "end": 28.0,
      "speaker_id": "synth_03",
      "text": "سأراجع المحضر دون موعد محدد."
    },
    {
      "id": "s04",
      "start": 30.0,
      "end": 38.0,
      "speaker_id": "synth_01",
      "text": "عدت إلى الحديث، ونؤجل الحكم على الجودة حتى التجربة الحقيقية."
    },
    {
      "id": "s05",
      "start": 40.0,
      "end": 48.0,
      "speaker_id": "synth_04",
      "text": "انضممت الآن. أراجع تنسيق التقرير يوم الخميس."
    },
    {
      "id": "s06",
      "start": 50.0,
      "end": 58.0,
      "speaker_id": "synth_02",
      "text": "عدت بالمعرف نفسه مع مستوى صوت أقل."
    },
    {
      "id": "s07",
      "start": 60.0,
      "end": 68.0,
      "speaker_id": "synth_05",
      "text": "انضممت الآن وأقترح مراجعة عينات اللغات."
    },
    {
      "id": "s08",
      "start": 70.0,
      "end": 78.0,
      "speaker_id": "synth_06",
      "text": "انضممت متأخرًا. ما الهاتف المستخدم في التجربة الحقيقية؟"
    },
    {
      "id": "s09",
      "start": 80.0,
      "end": 88.0,
      "speaker_id": "synth_04",
      "text": "عدت بالمعرف نفسه بعد الفاصل."
    },
    {
      "id": "s10",
      "start": 90.0,
      "end": 98.0,
      "speaker_id": "synth_06",
      "text": "عدت. لم نقس مسافة حقيقية في هذه العينة."
    },
    {
      "id": "s11",
      "start": 100.0,
      "end": 108.0,
      "speaker_id": "synth_03",
      "text": "عدت، ولا توجد نتيجة دقة آلية لهذه البيانات."
    }
  ],
  "minutes": {
    "summary": "توضح العينة شروط ضجيج وتخفيف رقمي مختلفة مع عودة المتحدثين. المهام المصرح بها هي مراجعة التسجيل والمحضر والتقرير. لا تثبت العينة دقة المزود أو مدى الميكروفون.",
