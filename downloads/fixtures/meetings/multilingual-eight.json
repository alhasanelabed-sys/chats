  "segments": [
    {
      "id": "s01",
      "start": 0.0,
      "end": 9.0,
      "speaker_id": "synth_01",
      "text": "נבדוק את הדוח מחר."
    },
    {
      "id": "s02",
      "start": 11.0,
      "end": 20.0,
      "speaker_id": "synth_02",
      "text": "Я проверю запись завтра."
    },
    {
      "id": "s03",
      "start": 22.0,
      "end": 31.0,
      "speaker_id": "synth_03",
      "text": "Θα ελέγξω την αναφορά αύριο."
    },
    {
      "id": "s04",
      "start": 33.0,
      "end": 42.0,
      "speaker_id": "synth_04",
      "text": "Я перевірю переклад завтра."
    },
    {
      "id": "s05",
      "start": 44.0,
      "end": 53.0,
      "speaker_id": "synth_05",
      "text": "我明天会检查报告。"
    },
    {
      "id": "s06",
      "start": 55.0,
      "end": 64.0,
      "speaker_id": "synth_06",
      "text": "من فردا گزارش را بررسی می‌کنم."
    },
    {
      "id": "s07",
      "start": 66.0,
      "end": 75.0,
      "speaker_id": "synth_07",
      "text": "میں کل رپورٹ کا جائزہ لوں گا۔"
    },
    {
      "id": "s08",
      "start": 77.0,
      "end": 86.0,
      "speaker_id": "synth_08",
      "text": "سأراجع المحضر غدًا."
    },
    {
      "id": "s09",
      "start": 88.0,
      "end": 97.0,
      "speaker_id": "synth_01",
      "text": "אין החלטה על מועד ההשקה."
    },
    {
      "id": "s10",
      "start": 99.0,
      "end": 108.0,
      "speaker_id": "synth_05",
      "text": "我们还没有决定发布日期。"
    },
    {
      "id": "s11",
      "start": 110.0,
      "end": 119.0,
      "speaker_id": "synth_08",
      "text": "يبقى موعد الإطلاق غير محدد."
    }
  ],
