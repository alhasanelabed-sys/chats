  "cases": [
    {
      "id": "recurring_six",
      "selected_language": "ar",
      "duration_seconds": 144,
      "timeline": [
        {
          "id": "s01",
          "speaker_id": "synth_01",
          "start": 0.0,
          "end": 7.2005,
          "text": "نبدأ اجتماع مراجعة النسخة التجريبية. نحتاج إلى خطة اختبار واضحة.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -3,
          "voice": "ar+m1",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -24.413966,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s02",
          "speaker_id": "synth_02",
          "start": 11.0,
          "end": 15.102688,
          "text": "سأراجع شاشة التسجيل وأرسل ملاحظاتي غدًا.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -9,
          "voice": "ar+f2",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -21.626115,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s03",
          "speaker_id": "synth_03",
          "start": 22.0,
          "end": 27.049625,
          "text": "اختبرت حفظ المحضر، ويحتاج البحث إلى تحسين.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -18,
          "voice": "ar+m3",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -24.389482,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s04",
          "speaker_id": "synth_01",
          "start": 33.0,
          "end": 37.123125,
          "text": "نراجع الملاحظات قبل أن نقرر إطلاق النسخة.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -3,
          "voice": "ar+m1",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -24.173098,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s05",
          "speaker_id": "synth_04",
          "start": 44.0,
          "end": 48.895,
          "text": "انضممت الآن. سأفحص استيراد الملفات يوم الخميس.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -24,
          "voice": "ar+f3",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -20.887834,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s06",
          "speaker_id": "synth_02",
          "start": 55.0,
          "end": 61.519063,
          "text": "عدت إلى النقاش. سأضيف اختبار العودة بعد إيقاف التسجيل مؤقتًا.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -9,
          "voice": "ar+f2",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -21.967431,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s07",
          "speaker_id": "synth_05",
          "start": 66.0,
          "end": 73.136375,
          "text": "انضممت بعد البداية. واجهة الترجمة تحتاج إلى مراجعة النص الطويل.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -6,
          "voice": "ar+m2",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -24.28224,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s08",
          "speaker_id": "synth_03",
          "start": 77.0,
          "end": 81.77425,
          "text": "عدت. سأراجع البحث دون تحديد موعد تسليم.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -18,
          "voice": "ar+m3",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -25.012706,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s09",
          "speaker_id": "synth_01",
          "start": 88.0,
          "end": 93.741625,
          "text": "اتفقنا على تأجيل الإطلاق حتى مراجعة تقارير الاختبار.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -3,
          "voice": "ar+m1",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -23.928551,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s10",
          "speaker_id": "synth_06",
          "start": 99.0,
          "end": 104.446187,
          "text": "انضممت متأخرًا. سأراجع تنسيق ملف PDF غدًا.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -21,
          "voice": "ar+f4",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -21.293489,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s11",
          "speaker_id": "synth_04",
          "start": 110.0,
          "end": 114.393937,
          "text": "عدت. أؤكد أن موعد تقرير الاستيراد يوم الخميس.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -24,
          "voice": "ar+f3",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -21.098808,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s12",
          "speaker_id": "synth_06",
          "start": 121.0,
          "end": 127.61475,
          "text": "عدت مرة ثانية، وسأضمّن أسماء المتحدثين في مراجعة PDF.",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -21,
          "voice": "ar+f4",
          "tempo_factor": 1,
          "clean_clip_metrics": {
            "rms_dbfs": -20.174774,
            "peak_dbfs": -6.0,
            "clipped_samples": 0
          }
        },
        {
          "id": "s13",
          "speaker_id": "synth_05",
          "start": 132.0,
          "end": 136.69425,
          "text": "عدت. كم لغة سنختبر في الجولة التالية؟",
          "language": "ar",
          "requested_language": "ar",
          "speech_gain_db": -6,
          "voice": "ar+m2",
          "tempo_factor": 1,
          "clean_clip_metrics": {
