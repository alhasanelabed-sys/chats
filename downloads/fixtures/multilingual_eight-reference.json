    {
      "id": "s01",
      "speaker_id": "synth_01",
      "start": 0.0,
      "end": 1.673812,
      "text": "נבדוק את הדוח מחר."
    },
    {
      "id": "s02",
      "speaker_id": "synth_02",
      "start": 11.0,
      "end": 12.996375,
      "text": "Я проверю запись завтра."
    },
    {
      "id": "s03",
      "speaker_id": "synth_03",
      "start": 22.0,
      "end": 24.431562,
      "text": "Θα ελέγξω την αναφορά αύριο."
    },
    {
      "id": "s04",
      "speaker_id": "synth_04",
      "start": 33.0,
      "end": 35.13175,
      "text": "Я перевірю переклад завтра."
    },
    {
      "id": "s05",
      "speaker_id": "synth_05",
      "start": 44.0,
      "end": 48.3805,
      "text": "我明天会检查报告。"
    },
    {
      "id": "s06",
      "speaker_id": "synth_06",
      "start": 55.0,
      "end": 58.234938,
      "text": "من فردا گزارش را بررسی می‌کنم."
    },
    {
      "id": "s07",
      "speaker_id": "synth_07",
      "start": 66.0,
      "end": 69.982187,
      "text": "میں کل رپورٹ کا جائزہ لوں گا۔"
    },
    {
      "id": "s08",
      "speaker_id": "synth_08",
      "start": 77.0,
      "end": 79.261938,
      "text": "سأراجع المحضر غدًا."
    },
    {
      "id": "s09",
      "speaker_id": "synth_01",
      "start": 88.0,
      "end": 89.946812,
      "text": "אין החלטה על מועד ההשקה."
    },
    {
      "id": "s10",
      "speaker_id": "synth_05",
      "start": 99.0,
      "end": 104.09025,
      "text": "我们还没有决定发布日期。"
    },
    {
      "id": "s11",
      "speaker_id": "synth_08",
      "start": 110.0,
      "end": 113.210625,
      "text": "يبقى موعد الإطلاق غير محدد."
    }
  ],
