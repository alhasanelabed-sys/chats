# Server v0.3 only; FFmpeg (ffprobe + ffmpeg) must be installed.
# Never put either value in source control or put OPENAI_API_KEY in the Android app.
MAJLIS_ACCESS_TOKEN=replace-with-a-random-token-at-least-24-characters-long
OPENAI_API_KEY=replace-with-your-server-side-openai-api-key
MAJLIS_SUMMARY_MODEL=gpt-4.1-mini
